---
import Layout from "../../layouts/Layout.astro";
import { fetchFromAPI, STRAPI_URL_IMAGES } from "../../lib/conection";
import {blocksToHtml} from "../../lib/lista.js";

interface Cine {
    id: number;
    Titulo: string;
    slug: string;
    artist: string;
    resumen: string;
    autor: string;
    fecha_publicacion: string;
    portada?: {
        url: string;
        alternativeText?: string;
    };
    contenido?: string;
}

export async function getStaticPaths() {
    const data = await fetchFromAPI("cines");
    const cines: Cine[] = data || [];

    return cines.map((cine: Cine) => ({
        params: { slug: cine.slug },
        props: { cine },
    }));
}

const { cine } = Astro.props;
---

<Layout>
    <div class="bg-[#FFFDE7] min-h-screen p-4 md:p-8 font-sans">
        <article
            class="bg-white rounded-[2.5rem] w-full max-w-[1200px] mx-auto p-8 md:p-12 shadow-sm"
        >
            <div class="mb-8">
                <div
                    class="flex items-baseline gap-3 mb-4 border-b border-transparent"
                >
                    <span
                        class="text-sm font-medium text-gray-500 uppercase tracking-wide"
                        >Cine</span
                    >
                </div>
                <h1 class="text-4xl md:text-5xl font-bold mb-4">
                    {cine.Titulo}
                </h1>   
                <div class="flex flex-wrap gap-4 text-sm text-gray-600">
                    <span><strong>Artista:</strong> {cine.artist}</span>
                    <span><strong>Autor:</strong> {cine.autor}</span>
                    <span
                        ><strong>Fecha:</strong>
                        {
                            new Date(
                                cine.fecha_publicacion,
                            ).toLocaleDateString("es-ES")
                        }</span
                    >
                </div>
            </div>

            {
                cine.portada && (
                    <div class="mb-8 rounded-2xl overflow-hidden">
                        <img
                            src={`${STRAPI_URL_IMAGES}${cine.portada.url}`}
                            alt={
                                cine.portada.alternativeText || cine.Titulo
                            }
                            class="w-full h-auto object-cover"
                        />
                    </div>
                )
            }
            <div class="mb-8">
                <p class="text-2xl text-gray-700 leading-relaxed">
                    {cine.resumen}
                </p>
            </div>

            {
                cine.contenido && (
                    <div class="prose prose-lg max-w-none">
                        <div set:html={cine.contenido} />
                    </div>
                )
            }
            <div class="mt-12 pt-8 border-t border-gray-200">
                <a
                    href="/Cine"
                    class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 font-medium transition-colors"
                >
                    ← Volver a Cine
                </a>
            </div>
        </article>
    </div>
</Layout>
