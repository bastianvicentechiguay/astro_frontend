---
import Layout from "../../layouts/Layout.astro";
import { fetchFromAPI, STRAPI_URL_IMAGES } from "../../lib/conection";
import { blocksToHtml } from "../../lib/lista.js";

interface Noticias {
    id: number;
    Titulo: string;
    slug: string;
    artist: string;
    resumen: string;
    autor: string;
    fecha_publicacion: string;
    portada?: {
        url: string;
        alternativeText?: string;
    };
    contenido?: string;
}

export async function getStaticPaths() {
    const data = await fetchFromAPI("noticias");
    const noticias: Noticias[] = data || [];

    return noticias.map((noticia: Noticias) => ({
        params: { slug: noticia.slug },
        props: { noticia },
    }));
}

const { noticia } = Astro.props;
---

<Layout>
    <div class="bg-[#FFFDE7] min-h-screen p-4 md:p-8 font-sans">
        <article
            class="bg-white rounded-[2.5rem] w-full max-w-[1200px] mx-auto p-8 md:p-12 shadow-sm"
        >
            <div class="mb-8">
                <div
                    class="flex items-baseline gap-3 mb-4 border-b border-transparent"
                >
                    <span
                        class="text-sm font-medium text-gray-500 uppercase tracking-wide"
                        >Noticias</span
                    >
                </div>
                <h1 class="text-4xl md:text-5xl font-bold mb-4">
                    {noticia.Titulo}
                </h1>
                <div class="flex flex-wrap gap-4 text-sm text-gray-600">
                    <span><strong>Artista:</strong> {noticia.artist}</span>
                    <span><strong>Autor:</strong> {noticia.autor}</span>
                    <span
                        ><strong>Fecha:</strong>
                        {
                            new Date(
                                noticia.fecha_publicacion,
                            ).toLocaleDateString("es-ES")
                        }</span
                    >
                </div>
            </div>

            {
                noticia.portada && (
                    <div class="mb-8 rounded-2xl overflow-hidden">
                        <img
                            src={`${STRAPI_URL_IMAGES}${noticia.portada.url}`}
                            alt={
                                noticia.portada.alternativeText ||
                                noticia.Titulo
                            }
                            class="w-full h-auto object-cover"
                        />
                    </div>
                )
            }
            <div class="mb-8">
                <p class="text-2xl text-gray-700 leading-relaxed">
                    {noticia.resumen}
                </p>
            </div>

            {
                noticia.contenido && (
                    <div class="prose prose-lg prose-slate max-w-none">
                        <div set:html={blocksToHtml(noticia.contenido)} />
                    </div>
                )
            }
            <div class="mt-12 pt-8 border-t border-gray-200">
                <a
                    href="/Noticias"
                    class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 font-medium transition-colors"
                >
                    ← Volver a Noticias
                </a>
            </div>
        </article>
    </div>
</Layout>
